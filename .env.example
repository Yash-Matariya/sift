# Copy to .env for local runs outside Docker. Docker Compose sets these itself.
DATABASE_URL=postgresql+psycopg://sift:sift@localhost:5435/sift
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
CHAT_MODEL=llama3.1:8b
# 0 = same answer for the same question. Grounded Q&A does not want sampling,
# and the eval set cannot mean anything if the number moves between runs.
TEMPERATURE=0

# Background ingestion (Celery) + the agentic loop
REDIS_URL=redis://localhost:6379/0
UPLOADS_DIR=./uploads

# Retrieval: "vector" or "hybrid"
RETRIEVAL_MODE=hybrid

# Provider: "ollama" (local, default) or "openai" (any OpenAI-compatible endpoint)
LLM_PROVIDER=ollama
# Only used when LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
